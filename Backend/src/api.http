###############################################################
# VISITING FACULTY PORTAL — COMPLETE API TEST FILE
# Install "REST Client" extension in VS Code to use this file.
# Click "Send Request" above any request to test it.
###############################################################

@BASE_URL = http://localhost:5000
@ADMIN_TOKEN    = PASTE_ADMIN_TOKEN_HERE
@FACULTY_TOKEN  = PASTE_FACULTY_TOKEN_HERE
@SUPER_ADMIN_TOKEN = PASTE_SUPER_ADMIN_TOKEN_HERE

# ─────────────────────────────────────────────────────────────
# Common IDs — change these to match your DB
# ─────────────────────────────────────────────────────────────
@FACULTY_ID     = 3
@FACULTY_UVFIN  = VF-2024-001
@ADMIN_ID       = 2
@COURSE_ID      = 1
@SEMESTER_ID    = 2
@SECTION_ID     = 1
@SUBJECT_ID     = 5
@ALLOCATION_ID  = 4
@ATTENDANCE_ID  = 10
@BILL_ID        = 7



###############################################################
# ██████████████████████████████████████████████████████████
# MODULE 1 — AUTH   /api/auth
# ██████████████████████████████████████████████████████████
###############################################################


### 1.1 Register Faculty
POST {{BASE_URL}}/api/auth/register/faculty
Content-Type: application/json

{
    "full_name": "Dr. Meena Sharma",
    "email": "meena.sharma@iips.ac.in",
    "password_hash": "Faculty@123",
    "phone_number": "9876543210",
    "address": "123, MG Road, Indore, MP",
    "qualification": "Ph.D Computer Science",
    "aadhaar_no": "123456789012",
    "account_no": "1234567890123",
    "bank_name": "State Bank of India",
    "ifsc_code": "SBIN0001234",
    "pan_card_no": "ABCDE1234F"
}

###

### 1.2 Register Admin
POST {{BASE_URL}}/api/auth/register/admin
Content-Type: application/json

{
    "full_name": "Admin User",
    "email": "admin@iips.ac.in",
    "password_hash": "Admin@123",
    "phone_number": "9876543211"
}

###

### 1.3 Login (Faculty) — Copy token from response → paste in @FACULTY_TOKEN above
POST {{BASE_URL}}/api/auth/login
Content-Type: application/json

{
    "email": "meena.sharma@iips.ac.in",
    "password_hash": "Faculty@123"
}

###

### 1.4 Login (Admin) — Copy token from response → paste in @ADMIN_TOKEN above
POST {{BASE_URL}}/api/auth/login
Content-Type: application/json

{
    "email": "admin@iips.ac.in",
    "password_hash": "Admin@123"
}

###

### 1.5 Login (Super Admin)
POST {{BASE_URL}}/api/auth/login
Content-Type: application/json

{
    "email": "abc@gmail.com",
    "password_hash": "ADMIN"
}

###

### 1.6 Logout
POST {{BASE_URL}}/api/auth/logout
Authorization: Bearer {{FACULTY_TOKEN}}

###

### 1.7 Forgot Password
POST {{BASE_URL}}/api/auth/forgotPassword/
Content-Type: application/json

{
    "email": "meena.sharma@iips.ac.in"
}

###

### 1.8 Reset Password
POST {{BASE_URL}}/api/auth/resetPassword
Content-Type: application/json

{
    "token": "PASTE_RESET_TOKEN_FROM_EMAIL",
    "password": "NewPassword@123"
}

###

### 1.9 Change Password
PUT {{BASE_URL}}/api/auth/changePassword
Authorization: Bearer {{FACULTY_TOKEN}}
Content-Type: application/json

{
    "oldPassword": "Faculty@123",
    "newPassword": "NewFaculty@456"
}

###

### 1.10 Update Profile
PUT {{BASE_URL}}/api/auth/update/{{FACULTY_ID}}
Authorization: Bearer {{FACULTY_TOKEN}}
Content-Type: application/json

{
    "full_name": "Dr. Meena Sharma",
    "phone_number": "9876543210",
    "address": "456, Vijay Nagar, Indore",
    "qualification": "Ph.D, M.Tech",
    "account_no": "9876543210123",
    "bank_name": "Punjab National Bank",
    "ifsc_code": "PUNB0123456",
    "pan_card_no": "ABCDE1234F"
}



